{
  "name": "MySituation",
  "version": "2.1.1",
  "description": "Personal situation dossier, court & daughter filing workspace, fiduciary record, and IP valuation assessment",
  "type": "luno-web-app",
  "mainClass": "SituationApp",
  "entrypoint": {
    "file": "js/SituationApp.js",
    "class": "SituationApp",
    "method": "run"
  },
  "main": [
    "js/SituationApp.js",
    "js/SnareDrumAnimation.js",
    "js/ValueEmberLogo.js",
    "js/AccuDrawValuation.js",
    "js/OverviewPage.js",
    "js/CourtFilingPage.js",
    "js/AiPerspectivePage.js",
    "js/ElderAdvocacyPage.js",
    "js/CaretakerBiasPage.js",
    "js/CurrentWorkPage.js",
    "js/ValuationPage.js",
    "js/SituationSummaries.js"
  ],
  "library": [
    "DomBasics.js",
    "UITools.js",
    "VideoPlayer.js",
    "DictationWidget.js",
    "DocumentReader.js",
    "SidePanel.js",
    "SupabaseCommentsAdapter.js",
    "CadPlanDataRegistry.js",
    "CadPlanItemNotes.js",
    "CadPlanDocumentEditor.js",
    "CadPlanAardvark.js",
    "SensitiveContextGate.js"
  ],
  "styles": [],
  "visibilitySets": {
    "situation-core": [
      "situation/js/SituationApp.js",
      "situation/index.html",
      "situation/luno.json"
    ],
    "overview-and-court": [
      "situation/js/OverviewPage.js",
      "situation/js/CourtFilingPage.js"
    ],
    "fiduciary-and-bias": [
      "situation/js/ElderAdvocacyPage.js",
      "situation/js/CaretakerBiasPage.js"
    ],
    "ai-and-current-work": [
      "situation/js/AiPerspectivePage.js",
      "situation/js/CurrentWorkPage.js"
    ],
    "valuation-and-fx": [
      "situation/js/ValuationPage.js",
      "situation/js/AccuDrawValuation.js",
      "situation/js/SnareDrumAnimation.js",
      "situation/js/ValueEmberLogo.js"
    ],
    "notes-inspector": [
      "Library/CadPlanAardvark.js",
      "Library/CadPlanItemNotes.js",
      "Library/CadPlanDocumentEditor.js",
      "Library/DocumentReader.js"
    ],
    "standalone-hosting": [
      "situation/server.js",
      "situation/deploy.js",
      "situation/package.json",
      "situation/DEPLOYMENT_GUIDE.md"
    ],
    "summaries-only": [
      "situation/js/SituationSummaries.js",
      "situation/luno.json"
    ]
  }
}
